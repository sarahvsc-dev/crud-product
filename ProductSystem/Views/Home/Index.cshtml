@{
    ViewData["Title"] = "Início";
}

<div class="home-page">

    <div class="home-header">
        <span class="system-name">PRODUCTSYSTEM</span>
        <span class="system-subtitle">PRODUCT MANAGEMENT SYSTEM</span>
    </div>

    <div class="home-content">

   

        <h1>GERENCIE SEUS<br />PRODUTOS</h1>

        <p>
            Uma maneira simples e elegante<br />
            de gerenciar seu catálogo.
        </p>

        <div class="home-line"></div>

        <div class="stats">

            <div class="stat">
                <span class="stat-number">CRUD</span>
                <span class="stat-label">PRODUTOS</span>
            </div>

            <div class="stat">
                <span class="stat-number">MVC</span>
                <span class="stat-label">ARQUITETURA</span>
            </div>

            <div class="stat">
                <span class="stat-number">.NET</span>
                <span class="stat-label">TECNOLOGIA</span>
            </div>

        </div>

        <div class="home-line"></div>

        <p>
            A plataforma completa para gerenciar o seu negócio.
        </p>

        <div class="home-action">

            <a asp-controller="Products"
               asp-action="Index"
               class="catalog-link">
                ACESSAR PRODUTOS
                <span>→</span>
            </a>

        </div>

    </div>

    

</div>