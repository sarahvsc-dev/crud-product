@model ProductSystem.Models.Product

<div class="container-fluid px-3 px-md-4 mt-4">

    <div class="row justify-content-center">

        <div class="col-12 col-sm-10 col-md-8 col-lg-6">

            <div class="mb-4">
                <h1 class="fw-bold">Detalhes do Produto</h1>
                <p class="text-muted">
                    Informações do produto selecionado.
                </p>
            </div>

            <div class="card shadow-sm">

                <div class="card-body p-3 p-md-4">

                    <div class="mb-3">
                        <strong>ID</strong>
                        <p class="mb-0">@Model.Id</p>
                    </div>

                    <div class="mb-3">
                        <strong>Data de Cadastro</strong>
                        <p class="mb-0">
                            @Model.RegistrationDate.ToString("dd/MM/yyyy HH:mm")
                        </p>
                    </div>

                    <div class="mb-3">
                        <strong>Usuário que cadastrou</strong>
                        <p class="mb-0">@Model.RegisteredBy</p>
                    </div>

                    <div class="mb-3">
                        <strong>Descrição</strong>
                        <p class="mb-0">@Model.Description</p>
                    </div>

                    <div class="mb-3">
                        <strong>Quantidade</strong>
                        <p class="mb-0">@Model.Quantity</p>
                    </div>

                    <div class="mb-4">
                        <strong>Valor</strong>
                        <p class="mb-0">
                            R$ @Model.Value.ToString("N2")
                        </p>
                    </div>

                    <div class="d-grid gap-2 d-md-flex">

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-warning">
                            Editar
                        </a>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Voltar
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>